---
import { ClientRouter } from 'astro:transitions';
import TabMap from '../components/TabMap.astro';
import '../styles/global.css';

interface Props {
  title: string;
  activeSlug?: string | null;
}

const { title, activeSlug = null } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Portfolio</title>
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Playwrite+AU+NSW+Guides&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <TabMap activeSlug={activeSlug}>
      <slot />
    </TabMap>
    <script>
      import '../scripts/folder-nav';
    </script>
  </body>
</html>
